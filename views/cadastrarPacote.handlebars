<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastrar Pacote</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Cadastrar Pacote</h1>

  <form action="/pacotes/cadastrar" method="POST">
    <div>
      <label for="nome">Nome:</label>
      <input type="text" id="nome" name="nome" required>
    </div>

    <div>
      <label for="descricao">Descrição:</label>
      <input type="text" id="descricao" name="descricao" required>
    </div>

    <div>
      <label for="preco">Preço:</label>
      <input type="number" id="preco" name="preco" step="0.01" required>
    </div>

    <div>
      <label for="agenciaId">Agência:</label>
      <select id="agenciaId" name="agenciaId" required> 
        <option value="">Selecione uma agência</option>
        {{#each agencias}}
          <option value="{{id}}">{{nome}}</option>
        {{/each}}
      </select>
    </div>

    <button type="submit">Cadastrar Pacote</button>
  </form>
    <a href="/">Voltar para a página inicial</a>
</body>
</html>
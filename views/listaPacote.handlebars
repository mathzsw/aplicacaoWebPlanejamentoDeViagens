<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Agências</title>
</head>
<body>

  <h1>Lista de Agências</h1>

  <a href="/agencias/cadastrar">Cadastrar Agência</a>

  <ul>
    {{#each agencias}}
      <li>
          <strong>Nome:</strong> {{nome}}<br>
          <strong>Descrição:</strong> {{descricao}}<br>
          <strong>Preço:</strong> R$ {{preco}}<br>
        </li>
    {{/each}}
  </ul>

  <a href="/">Voltar para a página inicial</a>

</body>
</html>
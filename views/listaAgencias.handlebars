<section class="pagina">
    <div class="pagina-cabecalho">
        <div>
            <h1>Agências</h1>
            <p class="subtitulo">Agências cadastradas para o planejamento de viagens.</p>
        </div>
        <a class="botao-principal" href="/agencias/cadastrar">+ Cadastrar agência</a>
    </div>

    {{#each agencias}}
        <div class="item">
            <h2>{{nome}}</h2>
            <p><strong>CNPJ:</strong> {{cnpj}}</p>
        </div>
    {{/each}}

    <a class="voltar" href="/">← Voltar para início</a>
</section>

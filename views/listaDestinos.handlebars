<section class="pagina">
    <div class="pagina-cabecalho">
        <div>
            <h1>Destinos</h1>
            <p class="subtitulo">Destinos disponíveis para suas viagens.</p>
        </div>
        <a class="botao-principal" href="/destinos/cadastrar">+ Cadastrar destino</a>
    </div>

    {{#each destinos}}
        <div class="item">
            <h2>{{nome}}</h2>
            <p><strong>País:</strong> {{pais}}</p>
        </div>
    {{/each}}

    <a class="voltar" href="/">← Voltar para início</a>
</section>

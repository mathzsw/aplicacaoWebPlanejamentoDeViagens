<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastrar Agência</title>
</head>
<body>
  <h1>Cadastrar Agência</h1>

  <form action="/agencias/cadastrar" method="POST">
    <div>
      <label for="nome">Nome:</label>
      <input type="text" id="nome" name="nome" required>
    </div>

    <div>
      <label for="cnpj">CNPJ:</label>
      <input type="text" id="cnpj" name="cnpj" required>
    </div>

    <div>
      <label for="destinosIds">Destinos:</label>
      <select id="destinosIds" name="destinosIds" multiple required>
        {{#each destinos}}
          <option value="{{id}}">{{nome}}</option>
        {{/each}}
      </select>
      <p>Use Ctrl + clique para selecionar mais de um destino.</p>
    </div>

    <button type="submit">Cadastrar Agência</button>
  </form>
  <a href="/home">Voltar para a página inicial</a>
</body>
</html>
<section class="pagina">
    <div class="pagina-cabecalho">
        <div>
            <h1>Pacotes</h1>
            <p class="subtitulo">Pacotes de viagem cadastrados.</p>
        </div>
        <a class="botao-principal" href="/pacotes/cadastrar">+ Cadastrar pacote</a>
    </div>

    {{#each pacotes}}
        <div class="item">
            <h2>{{nome}}</h2>
            <p><strong>Descrição:</strong> {{descricao}}</p>
            <p><strong>Preço:</strong> R$ {{preco}}</p>
            <p><strong>Agência:</strong> {{agencia.nome}}</p>
        </div>
    {{/each}}

    <a class="voltar" href="/">← Voltar para início</a>
</section>
